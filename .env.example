# ============================================================
# StockER — Environment Configuration
# ============================================================
# Copy this file to .env and fill in ALL values below.
# Docker Compose and the application both read from this file.
# NEVER commit the .env file — only .env.example is tracked.

# --- PostgreSQL / TimescaleDB ---
POSTGRES_DB=stocker
POSTGRES_USER=stocker
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Application Database URLs (uses the Postgres credentials above) ---
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_SYNC_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_neo4j_password
NEO4J_BROWSER_PORT=7474
NEO4J_BOLT_PORT=7687

# --- Redpanda / Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_PORT=19092
SCHEMA_REGISTRY_PORT=18081
REDPANDA_CONSOLE_PORT=8080

# --- Finnhub (Free: 60 calls/min) ---
# Get your key at: https://finnhub.io/register
FINNHUB_API_KEY=CHANGE_ME_finnhub_key

# --- Alpha Vantage (Free: 25 calls/day) ---
# Get your key at: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=CHANGE_ME_alphavantage_key

# --- FRED (Free: 120 calls/min) ---
# Get your key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=CHANGE_ME_fred_key

# --- LLM Provider ---
# Primary: Ollama (local, free). Ensure Ollama is running on your machine.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=deepseek-r1

# Fallback cloud providers (optional — leave blank if not used)
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Embedding Model ---
# Options: "ollama" (local, free) or "openai" (cloud, requires OPENAI_API_KEY)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# --- App Config ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]
