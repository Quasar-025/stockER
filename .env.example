# ============================================================
# StockER — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your API keys.
# All services use free tiers unless noted otherwise.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://stocker:stocker_dev@localhost:5432/stocker
DATABASE_SYNC_URL=postgresql+psycopg://stocker:stocker_dev@localhost:5432/stocker

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_PORT=6333

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=stocker_dev

# --- Redpanda / Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Finnhub (Free: 60 calls/min) ---
# Get your key at: https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_api_key_here

# --- Alpha Vantage (Free: 25 calls/day) ---
# Get your key at: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=your_alphavantage_api_key_here

# --- FRED (Free: 120 calls/min) ---
# Get your key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# --- LLM Provider ---
# Primary: Ollama (local, free). Ensure Ollama is running.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=deepseek-r1

# Fallback cloud providers (optional)
# OPENAI_API_KEY=your_openai_key_here
# GOOGLE_API_KEY=your_google_gemini_key_here

# --- Embedding Model ---
# Options: "ollama" (local, free) or "openai" (cloud)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
# If using OpenAI embeddings:
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small

# --- App Config ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]
